{
  "name": "custos-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custos check-in agent: deterministic scheduler + escalation, LLM only writes wording.",
  "scripts": {
    "demo": "tsx src/cli.ts demo",
    "demo:return": "tsx src/cli.ts demo --scenario return",
    "start": "tsx src/cli.ts serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:agent": "tsx src/cli.ts demo --scenario agent",
    "demo:agent-return": "tsx src/cli.ts demo --scenario agent-return"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
