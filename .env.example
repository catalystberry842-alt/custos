# All optional. The agent runs fully without any of these (mock/simulated mode, rules-based wording).
# NEVER put wallet private keys or seed phrases anywhere in this project.
ANTHROPIC_API_KEY=          # optional: Claude wording; falls back to rules if empty/invalid/no credit
ANTHROPIC_MODEL=            # optional override
TELEGRAM_BOT_TOKEN=         # optional: real Telegram delivery (from @BotFather)
HEIRLOOM_LINK_SECRET=       # recommended: random 32+ chars for signing check-in links
HEIRLOOM_STATE=./heirloom-state.json   # optional persistent dedupe state
HEIRLOOM_RPC_URL=https://rpc.monad.xyz # only for mode=chain (read-only)
